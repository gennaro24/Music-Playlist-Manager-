<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox minWidth="220.0" prefWidth="260.0" maxWidth="300.0" spacing="12" styleClass="sidebar"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unisa.sad.playlistmanager.ui.controller.PlaylistController">

    <Label styleClass="section-title" text="Le tue playlist"/>
    <ListView fx:id="listPlaylists" VBox.vgrow="ALWAYS"/>
    <TextField fx:id="txtPlaylistName" promptText="Nome playlist" visible="false"/>

    <Button fx:id="btnCreatePlaylist" maxWidth="Infinity" onAction="#handleCreatePlaylist"
            text="Nuova playlist" styleClass="btn-primary"/>
    <Button fx:id="btnAutoPlaylist" maxWidth="Infinity" onAction="#handleCreateAutoPlaylist"
            text="Playlist automatica" styleClass="btn-secondary"/>
    <Button fx:id="btnRemovePlaylist" maxWidth="Infinity" onAction="#handleRemovePlaylist"
            text="Rimuovi playlist" visible="false" styleClass="btn-danger"/>
    <Label fx:id="lblPlaylistFeedback" text="" styleClass="feedback-label"/>

</VBox>
