<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.sad.playlistmanager.ui.controller.TrackController">

    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <VBox fx:id="formAddTrack" spacing="10">
        <children>
            <Label style="-fx-font-weight: bold;" text="Aggiungi traccia al catalogo" />

            <GridPane fx:id="trackForm" hgap="10" vgap="8">
                <Label text="Titolo *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtTitle" promptText="Titolo" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Autore *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtAuthor" promptText="Autore" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Durata (sec) *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtDuration" promptText="Es. 180" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Genere *" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="txtGenre" promptText="Es. Rock" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Anno *" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="txtYear" promptText="Es. 2020" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>
         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
               <HBox>
                  <children>
            
                        <Button onAction="#handleTrackAddition" text="Aggiungi traccia" />
                  </children>
               </HBox>
               <Region HBox.hgrow="ALWAYS" />
               <HBox fx:id="hboxAddtoPlaylist" alignment="CENTER_RIGHT" spacing="15.0" visible="false">
                  <children>
                     <ComboBox fx:id="dropdownPlaylists" promptText="Seleziona una playlist" />
                     <Button fx:id="btnSaveAddPlaylist" mnemonicParsing="false" onAction="#handleSaveAddPlaylist" text="Salva" />
                  </children>
               </HBox>
            </children>
         </HBox>
        </children>
    </VBox>

    <TableView fx:id="tableTracks" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitle" prefWidth="180.0" text="Titolo" />
            <TableColumn fx:id="colAuthor" prefWidth="180.0" text="Autore" />
            <TableColumn fx:id="colDuration" prefWidth="90.0" text="Durata(sec)" />
            <TableColumn fx:id="colGenre" prefWidth="130.0" text="Genere" />
            <TableColumn fx:id="colYear" prefWidth="80.0" text="Anno" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="8.0">
        <children>
            <Button fx:id="btnRemoveFromPlaylist" managed="false" mnemonicParsing="false" onAction="#handleRemoveFromPlaylist" text="Rimuovi dalla playlist" visible="false" />
        </children>
    </HBox>

    <Label fx:id="lblFeedback" style="-fx-text-fill: red;" text="" />

</VBox>
