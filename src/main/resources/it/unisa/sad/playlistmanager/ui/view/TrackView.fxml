<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="track-view" spacing="10.0" maxHeight="Infinity" maxWidth="Infinity" minHeight="-Infinity"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unisa.sad.playlistmanager.ui.controller.TrackController">

    <HBox fx:id="hboxCatalogForms" alignment="TOP_LEFT" spacing="24.0" styleClass="catalog-forms-row"
          minHeight="-Infinity" VBox.vgrow="NEVER">

        <VBox fx:id="formAddTrack" spacing="8" styleClass="card" minHeight="-Infinity"
              prefWidth="520.0" maxWidth="540.0">
            <Label styleClass="section-title" text="Aggiungi traccia al catalogo"/>

            <GridPane fx:id="trackForm" hgap="8" vgap="6" minHeight="-Infinity">
                <columnConstraints>
                    <ColumnConstraints minWidth="68.0" prefWidth="68.0" maxWidth="72.0"/>
                    <ColumnConstraints minWidth="160.0" prefWidth="170.0" maxWidth="180.0"/>
                    <ColumnConstraints minWidth="68.0" prefWidth="68.0" maxWidth="72.0"/>
                    <ColumnConstraints minWidth="160.0" prefWidth="170.0" maxWidth="180.0"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="-Infinity" vgrow="NEVER"/>
                    <RowConstraints minHeight="-Infinity" vgrow="NEVER"/>
                </rowConstraints>

                <Label text="Titolo *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtTitle" maxWidth="170.0" minWidth="160.0" prefWidth="170.0"
                           promptText="Titolo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Autore *" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="txtAuthor" maxWidth="170.0" minWidth="160.0" prefWidth="170.0"
                           promptText="Autore" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Genere *" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtGenre" maxWidth="170.0" minWidth="160.0" prefWidth="170.0"
                           promptText="Es. Rock" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <HBox alignment="CENTER_LEFT" spacing="6.0" GridPane.columnIndex="2" GridPane.columnSpan="2"
                      GridPane.rowIndex="1">
                    <Label text="Durata *"/>
                    <TextField fx:id="txtDuration" maxWidth="64.0" minWidth="56.0" prefWidth="60.0" promptText="sec"/>
                    <Label text="Anno *"/>
                    <TextField fx:id="txtYear" maxWidth="64.0" minWidth="56.0" prefWidth="60.0" promptText="anno"/>
                </HBox>
            </GridPane>

            <HBox alignment="CENTER_LEFT" styleClass="form-actions-row" minHeight="-Infinity">
                <Button onAction="#handleTrackAddition" text="Aggiungi traccia"
                        styleClass="btn-primary" minHeight="34.0"/>
            </HBox>
        </VBox>

        <VBox fx:id="formTagManagement" spacing="6" styleClass="card tag-management-card"
              minHeight="-Infinity" prefWidth="250.0" maxWidth="260.0">
            <Label styleClass="section-title" text="Gestione tag"/>

            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <TextField fx:id="txtNewTag" minWidth="150.0" maxWidth="150.0" prefWidth="150.0" promptText="Nuovo tag"/>
                <Button mnemonicParsing="false" onAction="#handleCreateTag" text="Crea"
                        styleClass="btn-secondary" minHeight="34.0"/>
            </HBox>

            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <ComboBox fx:id="dropdownAllTags" minWidth="150.0" maxWidth="150.0" prefWidth="150.0" promptText="Tag"/>
                <Button mnemonicParsing="false" onAction="#handleDeleteTag" text="Elimina"
                        styleClass="btn-danger" minHeight="34.0"/>
            </HBox>
        </VBox>
    </HBox>

    <TableView fx:id="tableTracks" styleClass="data-table" minHeight="150.0" prefHeight="220.0"
               maxHeight="Infinity" maxWidth="Infinity" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitle" prefWidth="180.0" text="Titolo"/>
            <TableColumn fx:id="colAuthor" prefWidth="180.0" text="Autore"/>
            <TableColumn fx:id="colDuration" prefWidth="90.0" text="Durata (sec)"/>
            <TableColumn fx:id="colGenre" prefWidth="130.0" text="Genere"/>
            <TableColumn fx:id="colYear" prefWidth="80.0" text="Anno"/>
            <TableColumn fx:id="colTags" prefWidth="160.0" text="Tag"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <VBox spacing="4.0" styleClass="track-bottom-panel" minHeight="-Infinity" VBox.vgrow="NEVER">
        <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="action-toolbar" minHeight="40.0">
            <Button fx:id="btnPlayCatalog" managed="true" mnemonicParsing="false" onAction="#handlePlayCatalog"
                    text="▶ Riproduci catalogo" visible="true" styleClass="btn-primary" minHeight="34.0"/>
            <Button fx:id="btnAutoPlaylist" mnemonicParsing="false" onAction="#handleCreateAutoPlaylist"
                    text="Playlist automatica" styleClass="btn-secondary" minHeight="34.0"/>
            <HBox fx:id="hboxAddtoPlaylist" alignment="CENTER_LEFT" spacing="8.0"
                  visible="false" managed="false" styleClass="playlist-quick-add" minHeight="-Infinity">
                <ComboBox fx:id="dropdownPlaylists" minWidth="180.0" prefWidth="180.0"
                          promptText="Seleziona playlist"/>
                <Button fx:id="btnSaveAddPlaylist" mnemonicParsing="false" onAction="#handleSaveAddPlaylist"
                        text="Salva" styleClass="btn-add-to-playlist" minHeight="34.0"/>
            </HBox>
            <Button fx:id="btnRemoveFromPlaylist" managed="false" mnemonicParsing="false"
                    onAction="#handleRemoveFromPlaylist" text="Rimuovi dalla playlist" visible="false"
                    styleClass="btn-danger" minHeight="34.0"/>
        </HBox>
        <Label fx:id="lblFeedback" text="" styleClass="feedback-label" minHeight="18.0" maxHeight="28.0"/>
    </VBox>

</VBox>
