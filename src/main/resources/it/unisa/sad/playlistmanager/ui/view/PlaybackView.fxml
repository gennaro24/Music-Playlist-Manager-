<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="16.0" styleClass="player-bar"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unisa.sad.playlistmanager.ui.controller.PlaybackController">

    <VBox alignment="CENTER_LEFT" spacing="2.0" styleClass="player-track-info">
        <Label fx:id="labelTitle" text="Nessuna traccia in riproduzione" styleClass="player-title"/>
        <Label fx:id="labelArtist" managed="false" text="" visible="false" styleClass="player-artist"/>
    </VBox>

    <VBox alignment="CENTER_LEFT" prefWidth="100.0" spacing="2.0">
        <Label text="Stato" styleClass="player-meta-label"/>
        <Label fx:id="lblPlaybackStatus" text="STOPPED" styleClass="player-status"/>
    </VBox>

    <Region HBox.hgrow="ALWAYS"/>

    <HBox alignment="CENTER" spacing="4.0">
        <Label fx:id="timerTrack" text="0:00" styleClass="player-timer"/>
        <Label text="/" styleClass="player-timer-separator"/>
        <Label fx:id="durationTrack" text="0:00" styleClass="player-timer"/>
    </HBox>

    <Region HBox.hgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="player-controls">
        <Button fx:id="btnShuffle" mnemonicParsing="false" onAction="#toggleShuffle"
                prefWidth="72.0" text="🔀 OFF" styleClass="btn-player-toggle"/>
        <Button fx:id="btnLoop" mnemonicParsing="false" onAction="#handleQueueLoopToggle"
                prefWidth="72.0" text="🔂 OFF" styleClass="btn-player-toggle"/>
        <Button fx:id="btnPlayPauseTrack" mnemonicParsing="false" onAction="#PlayPauseTrack"
                text="▶" styleClass="btn-player-primary"/>
        <Button fx:id="skipButton" mnemonicParsing="false" onAction="#handleNext"
                text="⏭" styleClass="btn-player"/>
    </HBox>

</HBox>
